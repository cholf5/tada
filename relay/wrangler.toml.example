# 复制成 wrangler.toml 再改：仓库只提交这份模板。
#   cp wrangler.toml.example wrangler.toml
# 绑定名必须是 DB：relay 代码固定读取 env.DB。
name = "tada-relay"
main = "src/index.ts"
compatibility_date = "2025-01-01"

# `wrangler d1 create tada` 之后把 database_id 填在这里
[[d1_databases]]
binding = "DB"
database_name = "tada"
database_id = "REPLACE_ME"

# 前端构建产物（web/dist）和 API 同源部署，省掉 CORS
[assets]
directory = "../web/dist"
binding = "ASSETS"
not_found_handling = "single-page-application"
run_worker_first = true

[vars]
APP_ORIGIN = "https://tada-relay.YOUR-SUBDOMAIN.workers.dev"
# 可选：默认应用名。设置页保存过之后以 D1 里的品牌为准。
# APP_NAME = "Tada"
